    "components": {
        "securitySchemes": {
            "sessionCookie": {
                "type": "apiKey",
                "in": "cookie",
                "name": "job-tracker.sid",
                "description": "Sign in through /auth/github in this browser. The session cookie is sent automatically to same-origin requests."
            }
        },
        "parameters": {
            "DocumentId": {
                "name": "id",
                "in": "path",
                "required": true,
                "description": "MongoDB document ID",
                "schema": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{24}$"
                }
            }
        },
        "responses": {
            "BadRequest": {
                "description": "Invalid ID or request data",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Unauthorized": {
                "description": "An authenticated GitHub session is required",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/AuthenticationError"
                        }
                    }
                }
            },
            "NotFound": {
                "description": "Document not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "ServerError": {
                "description": "Internal server error",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        },
        "schemas": {
            "AuthStatus": {
                "type": "object",
                "properties": {
                    "authenticated": {
                        "type": "boolean"
                    },
                    "login": {
                        "type": "string",
                        "example": "/auth/github"
                    },
                    "user": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "username": {
                                "type": "string"
                            },
                            "displayName": {
                                "type": "string"
                            },
                            "profileUrl": {
                                "type": "string"
                            },
                            "avatarUrl": {
                                "type": "string",
                                "nullable": true
                            }
                        }
                    }
                }
            },
            "Error": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string",
                        "example": "Unable to process the request"
                    }
                }
            },
            "CompanyInput": {
                "type": "object",
                "required": [
                    "name",
                    "website",
                    "industry",
                    "location",
                    "contactName",
                    "contactEmail"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Acme Technology"
                    },
                    "website": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://www.example.com"
                    },
                    "industry": {
                        "type": "string",
                        "example": "Software"
                    },
                    "location": {
                        "type": "string",
                        "example": "Boise, Idaho"
                    },
                    "contactName": {
                        "type": "string",
                        "example": "Jordan Smith"
                    },
                    "contactEmail": {
                        "type": "string",
                        "format": "email",
                        "example": "jordan@example.com"
                    },
                    "notes": {
                        "type": "string",
                        "example": "Met at a university career fair."
                    }
                }
            },
            "Company": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/CompanyInput"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "_id": {
                                "type": "string",
                                "example": "68cb1234567890abcdef1234"
                            },
                            "createdAt": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "updatedAt": {
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    }
                ]
            },
            "ApplicationInput": {
                "type": "object",
                "required": [
                    "position",
                    "companyId",
                    "appliedDate",
                    "status",
                    "workMode",
                    "location",
                    "salaryRange",
                    "jobUrl",
                    "description",
                    "technologies"
                ],
                "properties": {
                    "position": {
                        "type": "string",
                        "example": "Junior Web Developer"
